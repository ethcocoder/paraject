{
  "name": "projected-ai-desktop",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Offline-first projected AI desktop interface",
  "homepage": "https://github.com/ethcocoder/paraject",
  "author": {"name": "Projected AI Interface", "email": "opensource@projected-ai.local"},
  "repository": {"type": "git", "url": "https://github.com/ethcocoder/paraject.git"},
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build:web": "vite build",
    "build:backend": "bash ../packaging/build_backend.sh",
    "dist": "npm run build:web && npm run build:backend && electron-builder",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.projectedai.desktop",
    "productName": "Projected AI Interface",
    "asar": true,
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "extraResources": [
      {"from": "../.models/smollm-135m", "to": "models/smollm-135m"},
      {"from": "../packaging/backend-dist", "to": "backend"}
    ],
    "linux": {"target": ["AppImage", "deb"], "category": "Utility", "maintainer": "opensource@projected-ai.local", "desktopName": "projected-ai-desktop", "syncDesktopName": true},
    "win": {"target": ["nsis"]},
    "mac": {"target": ["dmg"]}
  }
}
